# ==========================================
# FPL-BOT CONFIGURATION
# ==========================================

# Database XAMPP / Niagahoster cPanel
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fpl_bot
DB_USER=root
DB_PASS=

# Official FPL Account Credentials
FPL_TEAM_ID=4565338
FPL_EMAIL=your_fpl_email@example.com
FPL_PASSWORD=your_fpl_password

# Opsional: Cookie Sesi FPL (pl_profile) jika menggunakan 2FA atau proteksi login
FPL_COOKIE=

# Cron Security Token (untuk mencegah akses cron liar via browser)
CRON_SECRET_TOKEN=fpl_bot_secret_token_12345

# Opsional: Google Gemini API Key (untuk ringkasan analisis YouTube otomatis)
GEMINI_API_KEY=
