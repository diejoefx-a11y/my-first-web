# Options & Directives for Online Hosting (cPanel / Apache)
Options -Indexes

# Security: Block access to database dumps
<FilesMatch "^(.*\.sql)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# PHP Memory and File Upload Settings (if supported by server)
<IfModule mod_php7.c>
    php_value upload_max_filesize 32M
    php_value post_max_size 32M
    php_value memory_limit 128M
</IfModule>
<IfModule mod_php.c>
    php_value upload_max_filesize 32M
    php_value post_max_size 32M
    php_value memory_limit 128M
</IfModule>
